/*************************************************** Gerph *********
 Function:      templates_read_word
 Description:   Read a 32bit value from the open template file
 Parameters:    ot-> the template we are reading
 Returns:       the word we read
 ******************************************************************/
uint32_t templates_read_word(opentemplate_t *ot)
{
    uint32_t word;
    int read = fread(&word, 1, sizeof(word), ot->fh);
    if (read != sizeof(word))
        return READ_EOF;
    return word;
}

/*************************************************** Gerph *********
 Function:      templates_read
 Description:   Read an arbitrary size of data from the open template file
 Parameters:    ot-> the template we are reading
 Returns:       the amount of data we read
 ******************************************************************/
uint32_t templates_read(opentemplate_t *ot, void *dest, int size)
{
    int read;
    if (size == 0)
        return 0;
    read = fread(dest, 1, size, ot->fh);
    return read;
}

/*************************************************** Gerph *********
 Function:      templates_seek
 Description:   Seek to a place within the file, using the SEEK_* types
 Parameters:    ot-> the template we are reading
                offset = where to seek
                how = how to seek: SEEK_SET = absolute
                                   SEEK_CUR = relative to current
                                   SEEK_END = relative to end
 Returns:       error code
 ******************************************************************/
int templates_seek(opentemplate_t *ot, fileoffset_t offset, int how)
{
    int fail;
    //dprintf("templates_seek: offset=&%x, how=%i\n", offset, how);
    //msgi("templates_seek: offset = ", offset);
    //msgi("  how = ", how);
    fail = fseek(ot->fh, offset, how);
    if (fail)
    {
        //dprintf("templates_seek: failed\n");
        //msg("templates_seek: failed");
    }
    return fail ? TE_EOF : TE_OK;
}


/*************************************************** Gerph *********
 Function:      templates_open
 Description:   Open a template file (backend for Wimp_OpenTemplate)
 Parameters:    filename-> filename to open
 Returns:       pointer to a open template object, or NULL if we failed
 ******************************************************************/
opentemplate_t *templates_open(const char *filename)
{
    opentemplate_t *ot;
    FILE *fh;

    ot = calloc(1, sizeof(*ot));
    if (ot == NULL)
        return NULL;

    msgs("templates_open: ", filename);

    fh = fopen(filename, "rb");
    if (fh == NULL)
    {
        dprintf("templates_open: Failed to open file '%s'\n", filename);
        msg("Failed to open");
        free(ot);
        return NULL;
    }

    dprintf("templates_open: Opened template file '%s'\n", filename);
    ot->fh = fh;

    /* First word should be font data offset, then 3 words of 0s */
    ot->font_data_offset = templates_read_word(ot);
    if (ot->font_data_offset == 0xFFFFFFFFlu)
        ot->font_data_offset = 0;
    dprintf("Font data offset = &%05x\n", ot->font_data_offset);

    if (templates_read_word(ot) != 0 ||
        templates_read_word(ot) != 0 ||
        templates_read_word(ot) != 0)
    {
        dprintf("Initial words are not 0\n");
        msg("Initial header check failed");
        goto failed;
    }

    {
        /* Count the number of entries in the header */
        int nentries = 0;
        int size;
        templateindexentry_t *entries;
        while (1)
        {
            uint32_t data_offset = templates_read_word(ot);
            if (data_offset == 0)
                break;
            templates_seek(ot, sizeof(templateindexentry_t) - 4, SEEK_CUR);
            nentries++;
        }

        /* We've now counted the entries; so we can read the lot into out workspace */
        size = sizeof(templateindexentry_t) * nentries;
        entries = malloc(size);
        if (entries == NULL)
        {
            dprintf("Could not allocated memory for %i entries\n", nentries);
            msg("Could not allocate memory");
            goto failed;
        }

        templates_seek(ot, 16, SEEK_SET);
        ot->entries = entries;
        ot->nentries = nentries;
        if (templates_read(ot, entries, size) != size)
        {
            dprintf("Could not read all the template data; give up\n");
            msg("Could not read all template data");
            goto failed;
        }

        /* Validate all the entries */
        {
            int i;
            for (i =0; i < ot->nentries; i++)
            {
                int len = ctrlstrlen(ot->entries[i].identifier);
                if (len > 11)
                {
                    dprintf("Invalid length of the identifier in template %i\n", i);
                    msg("Bad template identifier length");
                    goto failed;
                }
                /* FIXME: identifiers should be allowed to be 12 character long, unterminated */

                ot->entries[i].identifier[len] = '\0';
                /* FIXME: Check the offset and length are in the file */
                /* FIXME: Should we check that the template names aren't repeated? */
            }
        }

        /* Load the font table */
        if (ot->font_data_offset == 0)
        {
no_font_data:
            ot->font_data_offset = 0;
            ot->nfonts = 0;
            ot->fonttable = NULL;
        }
        else
        {
            long filesize;
            long fonttablesize;
            int nfonts;
            int i;
            fseek(ot->fh, 0, SEEK_END);
            filesize = ftell(ot->fh);
            if (ot->font_data_offset == filesize)
                goto no_font_data;

            if (ot->font_data_offset > filesize)
            {
                dprintf("Font data has an invalid file offset\n");
                msg("Bad font data offset");
                goto failed;
            }
            fonttablesize = filesize - ot->font_data_offset;
            nfonts = (int)fonttablesize / sizeof(templatefontentry_t);
            if (fonttablesize % sizeof(templatefontentry_t) != 0)
            {
                dprintf("Font data has an invalid length (not a multiple of 48)\n");
                msg("Bad font data length");
                msgi("  nfonts = ", nfonts);
                msgi("  fonttablesize = ", fonttablesize);
                msgi("  sizeof(templatefontentry_t) = ", sizeof(templatefontentry_t));
                msgi("  modulo size = ", fonttablesize % sizeof(templatefontentry_t));
                goto failed;
            }
            ot->fonttable = malloc((int)fonttablesize);
            dprintf("Loading font data from &%x, of size %li; %i fonts\n", ot->font_data_offset, fonttablesize, nfonts);
            fseek(ot->fh, ot->font_data_offset, SEEK_SET);
            if (templates_read(ot, ot->fonttable, (int)fonttablesize) != fonttablesize)
            {
                dprintf("Failed to read font table\n");
                msg("Failed to read font table");
                goto failed;
            }
            ot->nfonts = nfonts;

            /* Ensure all the font names are terminated for easier handling. */
            for (i = 0; i<nfonts; i++)
            {
                char *fontname = ot->fonttable[i].fontname;
                int len = ctrlstrlen(fontname);
                if (len > sizeof(ot->fonttable[i].fontname) - 1)
                {
                    dprintf("Font name for index %i is not valid (too long, %i bytes)\n", i, len);
                    msgi("Font name for index is too long: ", i);
                    goto failed;
                }
                if (len == 0)
                {
                    dprintf("Font name for index %i is not valid (too short, %i bytes)\n", i, len);
                    msgi("Font name for index is too short: ", i);
                    goto failed;
                }
                fontname[len] = '\0';
                /* FIXME: We could check that the size of the font wasn't too large -
                          anything over say 256 could be faulted */
                if (ot->fonttable[i].xpointsize16 == 0 ||
                    ot->fonttable[i].ypointsize16 == 0)
                {
                    dprintf("Font size for index %i is not valid (%i x %i)\n", i, ot->fonttable[i].xpointsize16,
                                                                                  ot->fonttable[i].ypointsize16);
                    msgi("Font size for index is too long: ", i);
                    goto failed;
                }
            }
        }

#ifdef DEBUG
        {
            int i;
            dprintf("templates_open: Read header...\n");
            for (i =0; i < ot->nentries; i++)
            {
                dprintf("%3i : offset &%05x, size &%04x, type %u, identifier %s\n",
                        i,
                        ot->entries[i].data_offset,
                        ot->entries[i].data_size,
                        ot->entries[i].data_type,
                        ot->entries[i].identifier);
            }
            dprintf("templates_open: Read font table...\n");
            for (i = 0 ; i < ot->nfonts; i++)
            {
                templatefontentry_t *fe = &ot->fonttable[i];
                dprintf("%3i : Font '%s', %i.%04i x %i.%04i\n", i, fe->fontname,
                                                                fe->xpointsize16 / 16, 1000 * (fe->xpointsize16 % 16) / 16,
                                                                fe->ypointsize16 / 16, 1000 * (fe->ypointsize16 % 16) / 16);
            }
        }
#endif
    }

    /* Linked to our tracked chain */
    ot->next = opentemplates;
    opentemplates = ot;

    return ot;

failed:
    fclose(ot->fh);
    free(ot->entries);
    free(ot->fonttable);
    free(ot);
    /* FIXME: Better way of reporting errors ? */
    return NULL;
}

/*************************************************** Gerph *********
 Function:      templates_close
 Description:   Close an open template file
 Parameters:    ot-> the template to close
 Returns:       0 for success, 1 for failure
 ******************************************************************/
int templates_close(opentemplate_t *ot)
{
    /* Unlink from the chain */
    opentemplate_t **lastp = &opentemplates;
    opentemplate_t *cur = opentemplates;
    while (cur)
    {
        if (cur==ot)
        {
            *lastp = cur->next; /* unlink from the chain */

            dprintf("Closing open template file\n");
            fclose(ot->fh);
            free(ot->entries);
            free(ot->fonttable);
            free(ot);
            return 0;
        }

        lastp = &ot->next;
        ot = ot->next;
    }
    dprintf("File handle is not open - cannot close\n");
    return 1;
}


/*************************************************** Gerph *********
 Function:      templates_findidentifier
 Description:   Find a template block by its string identifier
 Parameters:    ot-> the template file we are operating on
                ctrl-> wildcarded identifier we are finding (ctrl-terminated)
                start = index to start at (0 to start enumeration)
 Returns:       index to the template to use, or -1 if invalid
 ******************************************************************/
int templates_findidentifier(opentemplate_t *ot, ctrlstring_t ctrl,
                             int start)
{
    int i;
    /* NOTE: In s/Wimp06 `matchnames` the comparison appears to be
     *       case insensitive - matches are with the EQ state afte
     *       a '#' character check, and uses a shortcut with TST &DF
     *       to ignore the case (and some non-alphbetic characters).
     *       For example '[' and '{' will be identical.
     */
    if (start < 0)
        start = 0;
    if (start >= ot->nentries)
        return -1;

    for (i=start; i<ot->nentries; i++)
    {
        templateindexentry_t *ientry = &ot->entries[i];
#ifdef SUPPORT_WILDCARDS
        if (wildmatch_wt(ctrl, ientry->identifier) == 1)
#else
        if (ctrlstricmp_wt(ctrl, ientry->identifier) == 0)
#endif
        {
            return i;
        }
    }
    return -1;
}

/*************************************************** Gerph *********
 Function:      templates_indextoname
 Description:   Convert a template index into a template name
 Parameters:    ot-> the template file we are operating on
                index = template number to find
 Returns:       pointer to the template identifier, or NULL if invalid
 ******************************************************************/
const char *templates_indextoname(opentemplate_t *ot, int index)
{
    if (index < 0 || index > ot->nentries)
        return NULL; /* Not found - there isn't any template with that index */
    return ot->entries[index].identifier;
}


typedef struct loadtemplatedata_s {
    opentemplate_t *ot;

    bufferdata_t *bufwin;
    bufferdata_t *bufind;
    fontusagetable_t *fontusage;
    fontclaim_f fontclaim;

    int base_offset;
} loadtemplatedata_t;


/*************************************************** Gerph *********
 Function:      templates_stringindirect
 Description:   Copy a string from the templates file to the indirect buffer, with length
 Parameters:    ltd-> load template data structure
                ind_offset = indirect data offset from window base offset
                length = the size in the indirect buffer, or -1 for any length
                textp-> where to store the indirect buffer text (or NULL if not written)
 Returns:       template error code
 ******************************************************************/
templateerror_t templates_stringindirect(loadtemplatedata_t *ltd,
                                         int ind_offset,
                                         int length,
                                         uint8_t **textp)
{
    int wrote = 0;
    uint8_t *text = bufferdata_address(ltd->bufind, 0, true);
    *textp = NULL;

    templates_seek(ltd->ot, ltd->base_offset + ind_offset, SEEK_SET);
    //dprintf("Reading indirect string from file offset &%x to address %p (length %i)\n", ltd->base_offset + ind_offset, text, length);
    //msgi("Reading indirect string from file offset ", ltd->base_offset + ind_offset);
    while (1)
    {
        int c = fgetc(ltd->ot->fh);
        //dprintf("  read byte %i\n", c);
        //msgi("  read byte ", c);
        if (c==EOF)
            return TE_EOF;

        if (c < 32)
            c = 0;
        if (length == -1 || wrote <= length - 1)
        {
            if (length != -1 && wrote == length - 1)
            {
                /* last byte, so we terminate */
                int zero = 0;
                bufferdata_write_bytes(ltd->bufind, &zero, 1);
            }
            else
            {
                bufferdata_write_bytes(ltd->bufind, &c, 1);
            }
            wrote += 1;
        }
        if (c == 0)
            break;
    }
    if (length != -1 && wrote != length)
    {
        /* Write padding to the end of the indirected data field */
        //dprintf("Padding by %i bytes\n", length - wrote);
        bufferdata_write_bytespadded(ltd->bufind, NULL, 0, length - wrote);
    }

    if (!bufferdata_failed(ltd->bufind))
        *textp = text;

    return TE_OK;
}


/*************************************************** Gerph *********
 Function:      templates_writeicondata
 Description:   Write an icondata into the user's buffer
 Parameters:    ltd-> the collected data for template loading.
                iconflags = the flags for the icon
                icondata-> the icon's data
 Returns:       template error code
 ******************************************************************/
static templateerror_t templates_writeicondata(loadtemplatedata_t *ltd,
                                               Wimp_IconFlags iconflags,
                                               Wimp_IconData *icondata)
{
    templateerror_t terr;

    dprintf("  Processing icon, flags &%08x\n", iconflags);
    msgi("  Processing icon, flags ", iconflags);

    if ( (iconflags & (Wimp_IconText | Wimp_IconSprite)) &&
         (iconflags & Wimp_IconIndirected) )
    {
        // Fixup if the icon contains text/sprite and is indirected.
        int text_offset = icondata->indirected_text.text;
        int validation_offset = icondata->indirected_text.validation;
        int32_t length = icondata->indirected_text.size;
        uint8_t *text = NULL;
        uint8_t *validation = NULL;

        if ( (iconflags & (Wimp_IconText | Wimp_IconSprite)) == Wimp_IconSprite )
        {
            // It's an indirected sprite, so it might have a sprite name, or might be
            // a sprite pointer. It's almost always going to be a sprite name, but we
            // check nonetheless.
            if (length == 0)
                // It's a sprite pointer; flag as an invalid text_offset
                text_offset = 0;
        }

        if (text_offset != 0)
        {
            terr = templates_stringindirect(ltd, text_offset, length, &text);
            if (terr != TE_OK)
                return terr;
        }

        if (iconflags & Wimp_IconText)
        {
            if (validation_offset != 0)
            {
                terr = templates_stringindirect(ltd, validation_offset, -1, &validation);
                if (terr != TE_OK)
                    return terr;
            }
        }

        dprintf("    Indirect Text(%i): %s\n", length, text ? (char*)text : "<not written>");
        dprintf("    Validation: %s\n", validation ? (char*)validation : "<not written>");

        if ( (iconflags & (Wimp_IconText | Wimp_IconSprite)) == Wimp_IconSprite )
        {
            /* Indirect sprite only */
            if ( text_offset == 0)
            {
                /* Indirect sprite points to actual sprite */
                icondata->indirected_sprite.id = (OSSpriteOp_Id)NULL;
                icondata->indirected_sprite.area = 0;
            }
            else
            {
                /* Indirect sprite points to the sprite name */
                icondata->indirected_sprite.id = (OSSpriteOp_Id)text;
                icondata->indirected_sprite.area = 0;
            }
        }
        else
        {
            /* Indirect text, or indirect text + sprite */
            icondata->indirected_text_and_sprite.text = (addr32_t)text;
            icondata->indirected_text_and_sprite.validation = (addr32_t)validation;
        }
    }
    else if (iconflags & Wimp_IconText)
    {
        dprintf("    Text string in icon: %.12s\n", icondata->text);
        msgs("    Text string in icon: ", (char*)icondata->text);
    }
    else if (iconflags & Wimp_IconSprite)
    {
        dprintf("    Sprite name in icon: %.12s\n", icondata->sprite);
        msgs("    Sprite name in icon: ", (char*)icondata->sprite);
    }

    bufferdata_write_bytes(ltd->bufwin, icondata, sizeof(*icondata));

    return TE_OK;
}

/*************************************************** Gerph *********
 Function:      templates_fixupiconfont
 Description:   Update the icon's font using the information from the template
 Parameters:    ltd-> the data for loading the file
                iconflags-> the flags for the icon to fix
 Returns:       none
 ******************************************************************/
templateerror_t templates_fixupiconfont(loadtemplatedata_t *ltd,
                                        Wimp_IconFlags *iconflags)
{
    Wimp_IconFlags flags = *iconflags;
    dprintf("  Icon flags &%08x\n", flags);
    msgi("  Icon flags: ", flags);
    if (flags & Wimp_IconAntiAliased)
    {
        /* This is antialiased, so we need to claim the font */
        int fontindex = (*iconflags & Wimp_IconFontHandle) >> Wimp_IconFontHandleShift;
        int fonthandle;
        templatefontentry_t *tfe;

        dprintf("  Is anti-aliased (font index %i)\n", fontindex);
        msgi("  Is anti-aliased using font index: ", fontindex);

        /* Clear the font index mask, to let us put the font handle in */
        *iconflags = *iconflags & ~Wimp_IconFontHandle;

        /* We need to...
         *   0. Validate parameters.
         *   1. Claim a font - and report errors if failed.
         *   2. Increment the counter in the font usage table.
         *   3. Write the font handle into the icon flags.
         */

        /* Validation */
        if (ltd->fontusage == NULL)
            return TE_FONTSNEEDED; /* They didn't supply a font usage table */
        if (fontindex == 0 || fontindex > ltd->ot->nfonts)
        {
            /* The PRM implies that this is not valid (only 1-nfonts) */
            return TE_FONTBADINDEX;
        }

        /* Claim font */
        tfe = &ltd->ot->fonttable[fontindex - 1];
#ifdef IN_ASM_WIMP
        fonthandle = font_claim(tfe->fontname, tfe->xpointsize16, tfe->ypointsize16);
#else
        fonthandle = ltd->fontclaim(tfe->fontname, tfe->xpointsize16, tfe->ypointsize16);
#endif
        dprintf("  Claim font gave: %i\n", fonthandle);
        if (fonthandle < 0 || fonthandle > 255)
        {
            return TE_FONTMISSING;
        }

        /* Increment usage */
        ltd->fontusage->used[fonthandle] += 1;

        /* Update icon flags */
        *iconflags = *iconflags | (fonthandle << Wimp_IconFontHandleShift);
    }
    return TE_OK;
}

/*************************************************** Gerph *********
 Function:      templates_readtemplate
 Description:   Read a template into a user buffer
 Parameters:    ot-> the template file we are operating on
                index = the index of the template we're reading
                bufwin-> the buffer to write the window into
                bufind-> the buffer to write indirected data into
                fontusage-> table of fonts used by this template
                enum_only = true if we're only enumerating, not writing to memory
                fontclaim = function which claims a font and returns handle
 Returns:       template error code
 ******************************************************************/
templateerror_t templates_readtemplate(opentemplate_t *ot, int index,
                                       bufferdata_t *bufwin,
                                       bufferdata_t *bufind,
                                       fontusagetable_t *fontusage,
                                       bool enum_only,
                                       fontclaim_f fontclaim)
{
    int size = ot->entries[index].data_size; // NOTE: We do not validate the content
    int offset = ot->entries[index].data_offset;
    int datatype = ot->entries[index].data_type;
    Wimp_Window win;
    int read;
    int iconnum;
    loadtemplatedata_t ltd;
    templateerror_t err;
    templates_seek(ot, offset, SEEK_SET);

    if (datatype == 1)
    {
        /* Wimp template */
        read = templates_read(ot, &win, Wimp_WindowHeaderSize);
        if (read != Wimp_WindowHeaderSize)
            return TE_EOF;

        bufferdata_write_bytes(bufwin, &win.visible, sizeof(win.visible));
        bufferdata_write_bytes(bufwin, &win.xscroll, sizeof(win.xscroll) + sizeof(win.yscroll));
        bufferdata_write_word(bufwin, 0xFFFFFFFF); /* Always force window to top */
        bufferdata_write_word(bufwin, win.flags);
        bufferdata_write_bytes(bufwin, &win.title_fg, sizeof(win.title_fg) * 7 + sizeof(win.extra_flags)); /* The colours */
        bufferdata_write_bytes(bufwin, &win.extent, sizeof(win.extent));
        bufferdata_write_bytes(bufwin, &win.title_flags, sizeof(win.title_flags) * 2); /* Title + work area flags */
        bufferdata_write_word(bufwin, 1); /* FIXME: Should I be forcing sprite area to be the Wimp sprite pool? */
        bufferdata_write_bytes(bufwin, &win.xmin, sizeof(win.xmin) * 2);

        ltd.ot = ot;
        ltd.bufwin = bufwin;
        ltd.bufind = bufind;
        ltd.fontusage = fontusage;
        ltd.fontclaim = fontclaim;
        ltd.base_offset = offset;
        dprintf("Writing window data from template offset &%x, %i icons\n", offset, win.icon_count);

        /* Fixup title data */
        dprintf("Process title icon data\n");
        msg("Process title icon data");
        err = templates_writeicondata(&ltd, win.title_flags, &win.title_data);
        if (err != TE_OK)
        {
            dprintf("Failed to create title icon data: %i\n", err);
            msgi("Failed to create title icon data: ", err);
            return err;
        }

        bufferdata_write_word(bufwin, win.icon_count);
        offset = Wimp_WindowHeaderSize;
        for (iconnum=0; iconnum < win.icon_count; iconnum++)
        {
            Wimp_Icon *icon = &win.icons[0];
            dprintf("Load icon #%i at offset &%x\n", iconnum, offset);
            msgi("Load icon #", iconnum);
            templates_seek(ot, ltd.base_offset + offset, SEEK_SET);
            read = templates_read(ot, icon, sizeof(Wimp_Icon));
            if (read != sizeof(Wimp_Icon))
                return TE_EOF;
            offset += read;

            bufferdata_write_bytes(bufwin, &icon->extent, sizeof(icon->extent));
            if (! bufferdata_failed(bufwin))
            {
                int *iconflagsp = (int*)bufferdata_address(bufwin, 0, true);
                msgi("  icon flags are at = ", (int)iconflagsp);
            }
            bufferdata_write_word(bufwin, icon->flags);

            /* Handle the icon data */
            err = templates_writeicondata(&ltd, icon->flags, &icon->data);
            if (err != TE_OK)
            {
                dprintf("Failed to create icon data: %i\n", err);
                msgi("Failed to create icon data: ", err);
                return err;
            }

        }

        if (! bufferdata_failed(bufwin) &&
            ! bufferdata_failed(bufind))
        {
            /* We fitted all the data into the window blocks and indirect blocks */
            /* Now we need to check for fonts in the windows */
            if (!enum_only)
            {
                /* Only apply fixup if we're not enumerating */
                msg("Fixup iconfont for title");
                err = templates_fixupiconfont(&ltd, &win.title_flags);
                if (err)
                {
                    dprintf("Fixup of the font for the title failed\n");
                    return err;
                }
                for (iconnum=0; iconnum < win.icon_count; iconnum++)
                {
                    Wimp_Window *win = (Wimp_Window *)bufferdata_address(bufwin, 0, false);
                    Wimp_Icon *icon = &win->icons[iconnum];
                    dprintf("Fix icon #%i font\n", iconnum);
                    msgi("Fixup iconfont for icon #", iconnum);
                    if (! bufferdata_failed(bufwin))
                    {
                        msgi("  icon flags are at = ", (int)&icon->flags);
                    }
                    err = templates_fixupiconfont(&ltd, &icon->flags);
                    if (err)
                    {
                        dprintf("Fixup of the font for icon %i failed\n", iconnum);
                        return err;
                    }
                }
            }
        }
    }
    else
    {
        /* Not a wimp template */
        /* If a non-template data object is requested, we only load the data into the buffer - no processing
           is performed */
        int remaining = bufferdata_remaining(bufwin);
        int read;
        if (remaining > size)
            remaining = size;
        templates_seek(ot, offset, SEEK_SET);
        read = templates_read(ot, bufferdata_address(bufwin, 0, true), remaining);
        if (read < remaining)
            return TE_EOF;
        /* We've read part of the data into the buffer memory; there may be more to come */
        size -= read;
        if (size > 0)
        {
            bufferdata_seek(bufwin, size, true);
        }
    }

    return TE_OK;
}




