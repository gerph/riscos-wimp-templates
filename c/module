/* The Wimp only had one template open at a time */
opentemplate_t *ot;



/***************************************************************************
 * Description:  SWI handler routine for Wimp_OpenTemplate
 * Parameters:   number = SWI number within SWI chunk (i.e. 0 to 63)
 *               r      = pointer to register block on entry
 *               pw     = private word for module
 * On exit:      Return NULL if SWI handled sucessfully, setting return
 *               register values (r0-r9) in r.
 *               Return error_BAD_SWI for out of range SWIs.
 *               Return an error block for a custom error.
 **************************************************************************/
_kernel_oserror *SWI_OpenTemplate(int number, _kernel_swi_regs *regs, void *pw)
{
    _kernel_oserror *err = NULL;
    /*
     * Wimp_OpenTemplate - Opens a specified template file
     *
     * =>  R1 -> file_name
     * <=  R0 corrupted
     */

    /* Input registers */
    char * file_name = (char *)regs->r[1];
    /* Output registers */

    if (ot != NULL)
        templates_close(ot);

    ot = templates_open(file_name);
    if (ot == NULL)
    {
        return err_WimpNoTemplateFile;
    }

    /* R0 corrupted */
    return err;
}




/***************************************************************************
 * Description:  SWI handler routine for Wimp_CloseTemplate
 * Parameters:   number = SWI number within SWI chunk (i.e. 0 to 63)
 *               r      = pointer to register block on entry
 *               pw     = private word for module
 * On exit:      Return NULL if SWI handled sucessfully, setting return
 *               register values (r0-r9) in r.
 *               Return error_BAD_SWI for out of range SWIs.
 *               Return an error block for a custom error.
 **************************************************************************/
_kernel_oserror *SWI_CloseTemplate(int number, _kernel_swi_regs *regs, void *pw)
{
    _kernel_oserror *err = NULL;
    /*
     * Wimp_CloseTemplate - Closes the currently open template file
     *
     * <=  R0 corrupted
     */

    /* Output registers */

    if (ot)
    {
        templates_close(ot);
        ot = NULL;
    }

    /* R0 corrupted */
    return err;
}


/*************************************************** Gerph *********
 Function:      font_claim
 Description:   Callback to claim a font for a window
 Parameters:    fontname-> the name to claim
                xpointsize16 = the font size in 24.4 format
                ypointsize16 = the font size in 24.4 format
 Returns:       -1 if failed, or handle from 1 - 255
 ******************************************************************/
int font_claim(const char *fontname, int xpointsize16, int ypointsize16)
{
    int fonthandle = 0;
    _kernel_oserror *err;
    dprintf("Font claim of '%s', at size %i x %i\n", fontname, xpointsize16, ypointsize16);
    err = _swix(Font_FindFont, _INR(1, 5) | _OUT(0), fontname, xpointsize16, ypointsize16, 0, 0, &fonthandle);
    if (err)
        return -1;
    if (fonthandle < 1 || fonthandle > 255)
    {
        /* FIXME: Should we LoseFont if they returned something out of spec? */
        return -1;
    }
    return fonthandle;
}


/***************************************************************************
 * Description:  SWI handler routine for Wimp_LoadTemplate
 * Parameters:   number = SWI number within SWI chunk (i.e. 0 to 63)
 *               r      = pointer to register block on entry
 *               pw     = private word for module
 * On exit:      Return NULL if SWI handled sucessfully, setting return
 *               register values (r0-r9) in r.
 *               Return error_BAD_SWI for out of range SWIs.
 *               Return an error block for a custom error.
 **************************************************************************/
_kernel_oserror *SWI_LoadTemplate(int number, _kernel_swi_regs *regs, void *pw)
{
    _kernel_oserror *err = NULL;
    /*
     * Wimp_LoadTemplate - Loads a template
     *
     * =>  R1 = window
     *     R2 = data
     *     R3 -> end
     *     R4 = font_ref
     *     R5 = name
     *     R6 = context
     * <=  R0 corrupted
     *     R1 = used
     *     R2 = data_used
     *     R6 = context_out
     */

#define LARGE_WINDOW_BUFFER (0xFFFFFF) /* A large value, as no end is specified in the API */

    /* Input registers */
    Wimp_Window * window = (Wimp_Window *)regs->r[1];
    uint8_t *data = (uint8_t *)regs->r[2];
    uint8_t *end = (uint8_t *)regs->r[3];
    fontusagetable_t *font_ref = (fontusagetable_t *)regs->r[4];
    char * template_name = (char *)regs->r[5];
    int32_t context = (int32_t)regs->r[6];

    /* Locals */
    templateerror_t terr;
    int template_num = 0;
    bufferdata_t bufwin;
    bufferdata_t bufind;
    bool enum_only = false;

#define READ_SIZE ((void*)(0xFFFFFFFFul))
#define NO_FONTS  ((void*)(0xFFFFFFFFul))

    if (window == READ_SIZE)
    {
        window = NULL;
        enum_only = true;
    }
    if (data == READ_SIZE || (end - data) == 0)
    {
        data = NULL;
        enum_only = true;
    }
    if (font_ref == NO_FONTS) /* -1 and 0 are 'no fonts' */
        font_ref = NULL;

    bufferdata_init(&bufwin, (uint8_t*)window, window == NULL ? 0 : LARGE_WINDOW_BUFFER);
    bufferdata_init(&bufind, data, data == NULL ? 0 : end - data);

    dprintf("Finding template '%s'\n", template_name);
    template_num = templates_findidentifier(ot, template_name, context);
    if (template_num == -1)
    {
        if (ctrlwildcarded(template_name))
        {
            /* They wanted to enumerate, but we're at the end */
            regs->r[1] = 0;
            regs->r[2] = 0;
            regs->r[6] = 0;
            return NULL;
        }
        return err_WimpNoTemplate;
    }
    dprintf("  Template number %i\n", template_num);

    if (ctrlwildcarded(template_name))
    {
        // They wildcarded the template name, so we need to replace the name they supplied.
        // This ONLY happens when the string is wildcarded. The documentation isn't clear, but implies this.
        // The original code explicitly only copies if wildcarded.
        // Note: We're not worrying about word alignment; Classic RISC OS Wimp MUST have it word aligned.
        const char *name = templates_indextoname(ot, template_num);
        dprintf("  Wildcard resolved to '%s'\n", name);
        strncpy(template_name, name, 12);
    }

    terr = templates_readtemplate(ot, template_num, &bufwin, &bufind, font_ref, enum_only, font_claim);
    if (terr)
        printf("Error reading template #%i: %i\n", template_num, terr);

    if (window == NULL)
    {
        regs->r[1] = bufferdata_required(&bufwin);
        regs->r[2] = bufferdata_required(&bufind);
    }
    else
    {
        regs->r[2] = (int)(data + bufferdata_required(&bufind));
    }

    dprintf("window buffering state: %s\n", bufferdata_failed(&bufwin) ? "FAIL" : "ok");
    dprintf("window buffer space needed: %i\n", bufferdata_required(&bufwin));
    dprintf("window buffer: %p\n", window);
    dprintf("indirect buffering state: %s\n", bufferdata_failed(&bufind) ? "FAIL" : "ok");
    dprintf("indirect buffer space needed: %i\n", bufferdata_required(&bufind));
    dprintf("indirect buffer: %p\n", data);

    if (bufferdata_failed(&bufind) && !enum_only)
        return err_WimpTooBig;

    regs->r[6] = template_num + 1;

    return err;
}
