REM> Test-load-template
REM Test that the dummy module template loading works.

winsize%=4096
indsize%=4096
REMindsize%=&34
DIM win% winsize%
DIM ind% indsize%
DIM tempname% 12
DIM fontusage% 256

template$="BlackBG"
file$="testdata.templates.palette"
REM file$="Templates"
REM file$="testdata.templates.fonttemplate":template$="desktop"
REMfile$="WimpTemplates":template$="error"
REMfile$="RO5WimpTemplates":template$="error"

SYS "WimpTemplates_OpenTemplate",, file$

FOR I=0TO255:fontusage%?I=0:NEXT

createwin%=TRUE
continue%=TRUE
next%=0
WHILE continue%
    $(tempname%) = template$
    SYS "WimpTemplates_LoadTemplate",, win%, ind%,ind%+indsize%, fontusage%, tempname%, next% TO ,reqwin%, indend%,r3,r4,name$, next%
    IF next% <> 0 THEN

        PRINT "Name: ";name$
        PRINT "  Required space: &";~reqwin%
        PRINT "  Indirect end: &";~indend%;"  Limit: &";~(ind%+indsize%)
        PRINT "  Next: ";next%

        IF createwin% THEN
            PRINT "Create window"
            SYS "Wimp_CreateWindow",,win% TO winh%
            PRINT "Got handle ";~winh%
            !win%=winh%:SYS "Wimp_GetWindowState",,win%
            !win%=winh%:SYS "Wimp_OpenWindow",,win%
            VDU4
            PRINT "Opened"
        ENDIF

        IF INSTR(template$, "*") = 0 AND INSTR(template$, "?") = 0 THEN
            continue%=FALSE
        ENDIF

    ELSE
        continue% = FALSE
    ENDIF

ENDWHILE
